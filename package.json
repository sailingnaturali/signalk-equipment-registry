{
  "name": "@sailingnaturali/signalk-equipment-registry",
  "version": "0.1.0",
  "description": "Serve a vessel equipment registry (manufacturer/model/serial per installed instance) as a SignalK resources/equipment resource.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-category-utility",
    "equipment",
    "registry",
    "marine"
  ],
  "author": "Bryan Clark",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sailingnaturali/signalk-equipment-registry.git"
  },
  "homepage": "https://github.com/sailingnaturali/signalk-equipment-registry#readme",
  "bugs": {
    "url": "https://github.com/sailingnaturali/signalk-equipment-registry/issues"
  },
  "signalk": {
    "displayName": "Equipment Registry"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@signalk/server-api": "^2.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
